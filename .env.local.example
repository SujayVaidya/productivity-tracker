# Upstash Redis (used in production so progress persists across Vercel's
# serverless invocations). Get these from the Vercel Storage tab after
# connecting the Upstash integration, or from the Upstash console directly.
#
# If these are unset, the app falls back to a local data/progress.json file
# -- fine for local dev, not usable on Vercel (read-only filesystem).

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
